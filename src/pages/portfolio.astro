---
import MainLayout from "../layouts/MainLayout.astro";
import { breadcrumbSchema, portfolioItemListSchema, webPageSchema } from "../lib/structured-data";
import projects from "../data/portfolio.json";
---

<MainLayout
  title="Portfolio | aretos.id"
  description="Studi kasus website dan aplikasi yang dikerjakan aretos.id beserta dampak bisnisnya."
  canonicalPath="/portfolio"
  ogImageAlt="Portfolio aretos.id — Studi kasus website dan aplikasi bisnis"
  keywords={["portfolio website", "studi kasus web app", "jasa aplikasi bisnis"]}
  structuredData={[
    webPageSchema(
      "Portfolio | aretos.id",
      "Studi kasus website dan aplikasi yang dikerjakan aretos.id beserta dampak bisnisnya.",
      "/portfolio"
    ),
    breadcrumbSchema([
      { name: "Beranda", path: "/" },
      { name: "Portfolio", path: "/portfolio" }
    ]),
    portfolioItemListSchema(projects)
  ]}
>
  <section class="section reveal">
    <div class="container reveal-delay-1">
      <span class="eyebrow">Portfolio</span>
      <h1>Studi kasus dengan tantangan nyata dan hasil yang terukur.</h1>
      <p class="lead">Format kerja kami selalu berangkat dari masalah bisnis, bukan langsung lompat ke teknologi.</p>
      <div class="grid-3 portfolio-grid">
        {
          projects.map((project, index) => (
            <article class={`card hover-lift portfolio-card reveal-delay-${Math.min(index + 1, 3)}`}>
              <figure class="portfolio-thumb">
                <img src={project.image} alt={project.imageAlt} loading="lazy" />
                {project.url && (
                  <a href={project.url} target="_blank" rel="noopener noreferrer" class="portfolio-badge" title="Kunjungi website" aria-label="Kunjungi website">
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
                      <polyline points="15 3 21 3 21 9" />
                      <line x1="10" y1="14" x2="21" y2="3" />
                    </svg>
                  </a>
                )}
              </figure>
              <h3>
                {project.url ? (
                  <a href={project.url} target="_blank" rel="noopener noreferrer">{project.title}</a>
                ) : (
                  project.title
                )}
              </h3>
              <details class="portfolio-details">
                <summary class="portfolio-expand">
                  <span class="when-closed">Lihat detail</span>
                  <span class="when-open">Tutup detail</span>
                </summary>
                <div class="portfolio-content">
                  <p><strong>Tantangan:</strong> {project.challenge}</p>
                  <p><strong>Solusi:</strong> {project.solution}</p>
                  <p><strong>Hasil:</strong> {project.impact}</p>
                </div>
              </details>
            </article>
          ))
        }
      </div>
    </div>
  </section>
</MainLayout>
